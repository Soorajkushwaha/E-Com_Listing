{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator registry document keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Administrator Firebase UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified administrator email address",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Product catalog record shared across Shop, Occasion Designs, and Bulk Packages.",
      "type": "object",
      "properties": {
        "sku": {
          "type": "string",
          "description": "Unique stock keeping unit identifier",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Primary product name",
          "minLength": 1,
          "maxLength": 200
        },
        "heading": {
          "type": "string",
          "description": "Catalog display heading",
          "minLength": 0,
          "maxLength": 200
        },
        "subtitle": {
          "type": "string",
          "description": "Short product subtitle",
          "minLength": 0,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "description": "Detailed product description",
          "minLength": 0,
          "maxLength": 2000
        },
        "category": {
          "type": "string",
          "description": "Product category",
          "minLength": 1,
          "maxLength": 100
        },
        "brand": {
          "type": "string",
          "description": "Brand name",
          "minLength": 1,
          "maxLength": 100
        },
        "imageUrl": {
          "type": "string",
          "description": "Primary image URL or SVG data URI",
          "minLength": 0,
          "maxLength": 10000
        },
        "sellingPrice": {
          "type": "number",
          "description": "Current selling price in INR"
        },
        "mrp": {
          "type": "number",
          "description": "Maximum retail price in INR"
        },
        "badge": {
          "type": "string",
          "description": "Promotional or seasonal badge text",
          "minLength": 0,
          "maxLength": 60
        },
        "campaign": {
          "type": "string",
          "description": "Associated campaign slug",
          "minLength": 0,
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "description": "Publication visibility status",
          "enum": ["active", "draft", "archived"]
        },
        "stockStatus": {
          "type": "string",
          "description": "Inventory availability status",
          "enum": ["in_stock", "low_stock", "made_to_order", "out_of_stock"]
        },
        "rating": {
          "type": "number",
          "description": "Average product rating from 0 to 5"
        },
        "ratingCount": {
          "type": "number",
          "description": "Number of customer ratings"
        },
        "amazonUrl": {
          "type": "string",
          "description": "Amazon marketplace purchase link",
          "minLength": 0,
          "maxLength": 500
        },
        "flipkartUrl": {
          "type": "string",
          "description": "Flipkart marketplace purchase link",
          "minLength": 0,
          "maxLength": 500
        },
        "meeshoUrl": {
          "type": "string",
          "description": "Meesho marketplace purchase link",
          "minLength": 0,
          "maxLength": 500
        },
        "websiteUrl": {
          "type": "string",
          "description": "Direct brand store purchase link",
          "minLength": 0,
          "maxLength": 500
        },
        "featured": {
          "type": "boolean",
          "description": "Whether product is featured in spotlight"
        },
        "sortOrder": {
          "type": "number",
          "description": "Numeric display sort order"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of administrator who created the record",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "sku",
        "name",
        "category",
        "brand",
        "sellingPrice",
        "mrp",
        "status",
        "stockStatus",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
