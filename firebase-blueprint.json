          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Creator or administrator UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "description": "Customer full name",
          "minLength": 1,
          "maxLength": 150
        },
        "companyName": {
          "type": "string",
          "description": "Business or company name",
          "minLength": 0,
          "maxLength": 150
        },
        "mobile": {
          "type": "string",
          "description": "Customer mobile number",
          "minLength": 7,
          "maxLength": 25
        },
        "whatsapp": {
          "type": "string",
          "description": "Customer WhatsApp number",
          "minLength": 7,
          "maxLength": 25
        },
        "email": {
          "type": "string",
          "description": "Customer email address",
          "minLength": 0,
          "maxLength": 254
        },
        "address": {
          "type": "string",
          "description": "Full delivery or venue street address",
          "minLength": 1,
          "maxLength": 500
        },
        "city": {
          "type": "string",
          "description": "Delivery city",
          "minLength": 1,
          "maxLength": 100
        },
        "state": {
          "type": "string",
          "description": "Delivery state",
          "minLength": 1,
          "maxLength": 100
        },
        "pinCode": {
          "type": "string",
          "description": "Postal PIN code",
          "minLength": 4,
          "maxLength": 16
        },
        "gstNumber": {
          "type": "string",
          "description": "Optional GSTIN",
          "minLength": 0,
          "maxLength": 30
        },
        "campaignSlug": {
          "type": "string",
          "description": "Event or campaign identifier",
          "minLength": 0,
          "maxLength": 100
        },
        "occasionSlug": {
          "type": "string",
          "description": "Selected occasion slug",
          "minLength": 0,
          "maxLength": 100
        },
        "decorationThemeSlug": {
          "type": "string",
          "description": "Selected decoration theme slug",
          "minLength": 0,
          "maxLength": 100
        },
        "eventDate": {
          "type": "string",
          "description": "Event date",
          "minLength": 0,
          "maxLength": 40
        },
        "venueLocation": {
          "type": "string",
          "description": "Venue name or location",
          "minLength": 0,
          "maxLength": 300
        },
        "guestCount": {
          "type": "string",
          "description": "Expected guest count",
          "minLength": 0,
          "maxLength": 80
        },
        "expectedDeliveryDate": {
          "type": "string",
          "description": "Requested delivery date",
          "minLength": 0,
          "maxLength": 40
        },
        "preferredContact": {
          "type": "string",
          "description": "Preferred contact channel",
          "enum": ["whatsapp", "phone", "email"]
        },
        "requirements": {
          "type": "string",
          "description": "Customer customization or packaging notes",
          "minLength": 0,
          "maxLength": 2000
        },
        "itemsSummary": {
          "type": "string",
          "description": "Human-readable summary of requested SKUs and quantities",
          "minLength": 1,
          "maxLength": 2000
        },
        "totalQuantity": {
          "type": "number",
          "description": "Total requested units across items"
        },
        "estimatedAmount": {
          "type": "number",
          "description": "Initial catalog price estimate in INR"
        },
        "finalAmount": {
          "type": "number",
          "description": "Final quoted total in INR including GST and shipping"
        },
        "status": {
          "type": "string",
          "description": "Current order lifecycle status",
          "enum": [
            "New Request",
            "Contact Customer",
            "Quote Prepared",
            "Awaiting Customer Approval",
            "Order Confirmed",
            "Awaiting Payment",
            "Paid",
            "Processing",
            "Dispatched",
            "Delivered",
            "Cancelled",
            "Rejected"
          ]
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment verification status",
          "enum": ["unpaid", "link_sent", "paid", "refunded"]
        },
        "paymentLink": {
          "type": "string",
          "description": "Manual payment link sent after order confirmation",
          "minLength": 0,
          "maxLength": 500
        },
        "transactionRef": {
          "type": "string",
          "description": "Verified payment transaction reference",
          "minLength": 0,
          "maxLength": 120
        },
        "courierName": {
          "type": "string",
          "description": "Logistics partner name",
          "minLength": 0,
          "maxLength": 100
        },
        "trackingNumber": {
          "type": "string",
          "description": "Shipment AWB or tracking number",
          "minLength": 0,
          "maxLength": 100
        },
        "internalNotes": {
          "type": "string",
          "description": "Private administrator notes",
          "minLength": 0,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Order creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "orderRef",
        "ownerId",
        "customerName",
        "mobile",
        "whatsapp",
        "address",
        "city",
        "state",
        "pinCode",
        "preferredContact",
        "itemsSummary",
        "totalQuantity",
        "estimatedAmount",
        "finalAmount",
        "status",
        "paymentStatus",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator lookup table."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Shared product catalog collection."
    },
    "/themes/{themeId}": {
      "schema": { "$ref": "#/entities/CatalogTheme" },
      "description": "Saved catalog themes and presets."
    },
    "/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/Campaign" },
      "description": "Seasonal and B2B catalog campaigns."
    },
    "/occasions/{occasionId}": {
      "schema": { "$ref": "#/entities/Occasion" },
      "description": "Occasions and celebration categories (Wedding, Birthday, Corporate, Diwali, etc.)."
    },
    "/decorationThemes/{themeId}": {
      "schema": { "$ref": "#/entities/DecorationTheme" },
      "description": "Decoration themes associated with occasions."
    },
    "/decorationDesigns/{designId}": {
      "schema": { "$ref": "#/entities/DecorationDesign" },
      "description": "Decoration design gallery items under occasion themes."
    },
    "/designProducts/{mappingId}": {
      "schema": { "$ref": "#/entities/DesignProductMapping" },
      "description": "Relational mapping of existing products used in decoration designs."
    },
    "/packages/{packageId}": {
      "schema": { "$ref": "#/entities/DecorationPackage" },
      "description": "Customizable bulk decoration packages."
    },
    "/packageProducts/{mappingId}": {
      "schema": { "$ref": "#/entities/PackageProductMapping" },
      "description": "Relational mapping of existing products included in bulk decoration packages."
    },
    "/bulkOrders/{orderId}": {
      "schema": { "$ref": "#/entities/BulkOrder" },
      "description": "Customer bulk order requests and quotations (contains PII, isolated to owner/admin)."
    }
  }
}
